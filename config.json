{
  "input": [
    {
      "type": "maxmindGeoLite2CountryCSV",
      "action": "add",
      "args": {
        "country": "./geolite2/GeoLite2-Country-Locations-en.csv",
        "ipv4": "./geolite2/GeoLite2-Country-Blocks-IPv4.csv",
        "ipv6": "./geolite2/GeoLite2-Country-Blocks-IPv6.csv",
        "wantedList": ["ru", "by"]
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru",
        "uri": "./geolite_ru.lst",
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "by",
        "uri": "./geolite_by.lst",
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "maxmindGeoLite2ASNCSV",
      "action": "add",
      "args": {
        "ipv4": "./geolite2/GeoLite2-ASN-Blocks-IPv4.csv",
        "ipv6": "./geolite2/GeoLite2-ASN-Blocks-IPv6.csv",
        "wantedList": {
          "telegram": ["AS62041", "AS62014", "AS59930", "AS44907", "AS211157"],
          "netflix":  ["AS55095", "AS40027", "AS394406", "AS2906"],
          "twitter":  ["AS8945", "AS63179", "AS54888", "AS35995", "AS13414"],
          "facebook": ["AS63293", "AS54115", "AS32934"]
        }
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "telegram",
        "uri": "https://core.telegram.org/resources/cidr.txt"
      }
    },
    {
      "type": "private",
      "action": "add"
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputName": "geoip.dat"
      }
    },
    {
      "type": "text",
      "action": "output",
      "args": {
        "outputDir": "./output/text"
    },
    {
      "type": "mihomoMRS",
      "action": "output"
    },
    {
      "type": "singboxSRS",
      "action": "output"
    }
  ]
}
